<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 坐标：仓库里定位本项目的三元组，不是「随便起的名字」 -->
    <groupId>com.example.maventask</groupId>
    <artifactId>maventask-day1</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>maventask-day1</name>

    <properties>
        <!-- 源码/资源统一 UTF-8，避免 Windows 默认编码把中文搞乱 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 本机是 JDK 21，字节码先固定 17，保证能在 17+ 的 JVM 上跑 -->
        <maven.compiler.release>17</maven.compiler.release>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencies>
        <!-- Day 1 要求的「Maven dependency」：测试用，不会打进最终 jar -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <!-- JUnit 5 需要较新的 surefire，否则 test 阶段可能发现不了测试 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <!-- 把主类写进 MANIFEST，才能 java -jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.example.maventask.TaskApp</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
